#: ../templates/backend/settings-page.phtml:43
#, php-format
msgid "%1$s Settings"
msgstr "Réglages de la %1$s"

#: ../templates/backend/settings-page.phtml:55
msgid "Plugin settings"
msgstr "Réglages de l'extension"

#: ../templates/backend/settings-page.phtml:59
#, php-format
msgid "Automate %1$s for all images in pages, posts and galleries"
msgstr ""
"Automatiser %1$s pour toutes les images dans les pages, articles et galeries"

#: ../templates/backend/settings-page.phtml:63
msgid ""
"Automatically add colorbox-class to images in posts and pages. Also adds "
"colorbox-class to galleries. Images in one page or post are grouped "
"automatically."
msgstr ""
"Ajouter automatiquement une classe \"colorbox-class\" aux images dans les "
"articles et pages. Ajouter aussi une classe \"colorbox-class\" aux galeries. "
"Les images sur une page ou un article sont automatiquement groupées."

#: ../templates/backend/settings-page.phtml:68
#, php-format
msgid "Automate %1$s for images in WordPress galleries only"
msgstr "Automatiser %1$s pour les images des galeries WordPress seulement"

#: ../templates/backend/settings-page.phtml:72
msgid ""
"Automatically add colorbox-class to images in WordPress galleries, but "
"nowhere else. Images in one page or post are grouped automatically."
msgstr ""
"Ajouter automatiquement une classe \"colorbox-class\" aux images dans les "
"galeries WordPress, mais nulle part ailleurs. Les images sur une page ou un "
"article sont automatiquement groupées."

#: ../templates/backend/settings-page.phtml:77
#, php-format
msgid "Automate %1$s for all other images"
msgstr "Automatiser %1$s pour toutes les autres images"

#: ../templates/backend/settings-page.phtml:81
msgid ""
"Automatically add colorbox-class to all images that are not in posts and "
"pages (e.g. the sidebar)."
msgstr ""
"Ajouter automatiquement la classe \"colorbox-class\" à toutes les images qui "
"ne sont pas dans les articles et les pages (ex : dans la barre latérale)."

#: ../templates/backend/settings-page.phtml:86
msgid "Automate hiding of flash objects"
msgstr "Masquage automatique des objets flash"

#: ../templates/backend/settings-page.phtml:90
msgid "Automatically hide embeded flash objects behind the Colorbox layer."
msgstr ""
"Masquer automatiquement les objets flash intégrés derrière la couche de la "
"Colorbox."

#: ../templates/backend/settings-page.phtml:95
msgid "Add Zoom overlay to pictures"
msgstr "Ajouter un effet de zoom sur les images"

#: ../templates/backend/settings-page.phtml:99
msgid "Add Zoom overlay to pictures that open in a Colorbox."
msgstr ""
"Ajouter un effet de zoom sur les images qui s’ouvrent dans une Colorbox."

#: ../templates/backend/settings-page.phtml:113
msgid "Add JavaScript to footer"
msgstr "Ajouter le JavaScript dans le pied de page"

#: ../templates/backend/settings-page.phtml:117
msgid "Add JavaScript to footer instead of the header."
msgstr "Ajouter le JavaScript dans le pied de page au lieu de dans l'en-tête."

#: ../templates/backend/settings-page.phtml:122
msgid "Remove link from Meta-box"
msgstr "Enlever le lien de la Meta-box"

#: ../templates/backend/settings-page.phtml:126
msgid "Remove the link to the developers site from the WordPress meta-box."
msgstr ""
"Enlever le lien vers le site du développeur de la meta-box de Wordpress."

#: ../templates/backend/settings-page.phtml:131
msgid "Disable warning"
msgstr "Désactiver l'avertissement"

#: ../templates/backend/settings-page.phtml:135
msgid ""
"Disables the warning that is displayed if the plugin is activated but the "
"auto-colorbox feature for all images is turned off."
msgstr ""
"Désactive l'avertissement qui est affiché si le plugin est activé mais que "
"la fonction auto-colorbox pour toutes les images est inactif."

#: ../templates/backend/settings-page.phtml:141
#: ../templates/backend/settings-page.phtml:411
msgid "Save Changes"
msgstr "Enregistrer les modifications"

#: ../templates/backend/settings-page.phtml:147
msgid "Colorbox settings"
msgstr "Paramètres de Colorbox"

#: ../templates/backend/settings-page.phtml:151
msgid "Theme"
msgstr "Thème"

#: ../templates/backend/settings-page.phtml:163
msgid "Select the theme you want to use on your blog."
msgstr "Sélectionner le thème que vous voulez utiliser sur votre blog."

#: ../templates/backend/settings-page.phtml:168
msgid "Theme screenshot"
msgstr "Aperçu du thème"

#: ../templates/backend/settings-page.phtml:183
msgid "Add Slideshow to groups"
msgstr "Ajouter un diaporama aux groupes"

#: ../templates/backend/settings-page.phtml:187
#, php-format
msgid "Add Slideshow functionality for %1$s Groups"
msgstr "Ajouter la fonction Diaporama aux groupes de la %1$s"

#: ../templates/backend/settings-page.phtml:192
msgid "Start Slideshow automatically"
msgstr "Démarrer automatiquement le diaporama"

#: ../templates/backend/settings-page.phtml:196
#, php-format
msgid ""
"Start Slideshow automatically if slideshow functionality is added to %1$s "
"Groups"
msgstr ""
"Démarrer automatiquement le diaporama si la fonction Diaporama a été ajoutée "
"aux groupes de la %1$s"

#: ../templates/backend/settings-page.phtml:201
msgid "Speed of the slideshow"
msgstr "Vitesse du diaporama"

#: ../templates/backend/settings-page.phtml:204
#: ../templates/backend/settings-page.phtml:395
msgid "milliseconds"
msgstr "millisecondes"

#: ../templates/backend/settings-page.phtml:205
msgid "Sets the speed of the slideshow, in milliseconds"
msgstr "Fixe la vitesse du diaporama en millisecondes"

#: ../templates/backend/settings-page.phtml:210
msgid "Maximum width of an image"
msgstr "Largeur maximum d'une image"

#: ../templates/backend/settings-page.phtml:214
#: ../templates/backend/settings-page.phtml:260
#: ../templates/backend/settings-page.phtml:306
msgid "Do not set width"
msgstr "Ne pas fixer la largeur"

#: ../templates/backend/settings-page.phtml:217
msgid "Set maximum width of an image"
msgstr "Fixer la largeur maximum d'une image"

#: ../templates/backend/settings-page.phtml:228
msgid ""
"Set the maximum width of the image in the Colorbox in relation to the "
"browser window in percent or pixels. If maximum width is not set, image is "
"as wide as the Colorbox"
msgstr ""
"Définir la largeur maximale de l’image dans la Colorbox par rapport à la "
"fenêtre du navigateur, en pourcentage ou en pixels. Si aucune largeur "
"maximale n’est définie, l’image adopte la largeur de la Colorbox"

#: ../templates/backend/settings-page.phtml:233
msgid "Maximum height of an image"
msgstr "Hauteur maximum d'une image"

#: ../templates/backend/settings-page.phtml:237
#: ../templates/backend/settings-page.phtml:283
#: ../templates/backend/settings-page.phtml:329
msgid "Do not set height"
msgstr "Ne pas fixer la hauteur"

#: ../templates/backend/settings-page.phtml:240
msgid "Set maximum height of an image"
msgstr "Fixer la hauteur maximum d'une image"

#: ../templates/backend/settings-page.phtml:251
msgid ""
"Set the maximum height of the image in the Colorbox in relation to the "
"browser window to a value in percent or pixels. If maximum height is not "
"set, the image is as high as the Colorbox"
msgstr ""
"Définir la largeur maximale de l’image dans la Colorbox par rapport à la "
"fenêtre du navigateur, en pourcentage ou en pixels. Si aucune largeur "
"maximale n’est définie, l’image adopte la largeur de la Colorbox"

#: ../templates/backend/settings-page.phtml:256
msgid "Maximum width of the Colorbox"
msgstr "Largeur maximum de la Colorbox"

#: ../templates/backend/settings-page.phtml:263
#: ../templates/backend/settings-page.phtml:309
msgid "Set width of the Colorbox"
msgstr "Fixer la largeur de la Colorbox"

#: ../templates/backend/settings-page.phtml:274
#: ../templates/backend/settings-page.phtml:320
msgid ""
"Set the maximum width of the Colorbox itself in relation to the browser "
"window to a value between in percent or pixels. If the image is bigger than "
"the colorbox, scrollbars are displayed. If width is not set, the Colorbox "
"will be as wide as the picture in it"
msgstr ""
"Définir la largeur maximale de la Colorbox par rapport à la fenêtre du "
"navigateur, en pourcentage ou en pixels. Si l’image dépasse cette largeur, "
"des barres de défilement seront affichées. Si aucune largeur n’est définie, "
"la Colorbox adoptera la largeur de l’image qu’elle contient"

#: ../templates/backend/settings-page.phtml:279
msgid "Maximum height of the Colorbox"
msgstr "Hauteur maximum de la Colorbox"

#: ../templates/backend/settings-page.phtml:286
#: ../templates/backend/settings-page.phtml:332
msgid "Set height of the Colorbox"
msgstr "Fixer la hauteur de la Colorbox"

#: ../templates/backend/settings-page.phtml:297
#: ../templates/backend/settings-page.phtml:343
msgid ""
"Set the maximum height of the Colorbox itself in relation to the browser "
"window to a value between in percent or pixels. If the image is bigger than "
"the colorbox, scrollbars are displayed. If height is not set, the Colorbox "
"will be as high as the picture in it"
msgstr ""
"Définir la hauteur maximale de la Colorbox par rapport à la fenêtre du "
"navigateur, en pourcentage ou en pixels. Si l’image dépasse cette hauteur, "
"des barres de défilement seront affichées. Si aucune hauteur n’est définie, "
"la Colorbox adoptera la hauteur de l’image qu’elle contient"

#: ../templates/backend/settings-page.phtml:302
msgid "Maximum width of the Colorbox used for links"
msgstr "Largeur maximale de la fenêtre Colorbox pour les liens"

#: ../templates/backend/settings-page.phtml:325
msgid "Maximum height of the Colorbox used for links"
msgstr "Hauteur maximale de la fenêtre Colorbox pour les liens"

#: ../templates/backend/settings-page.phtml:348
msgid "Resize images"
msgstr "Redimensionner les images"

#: ../templates/backend/settings-page.phtml:352
msgid ""
"If enabled and if maximum width of images, maximum height of images, width "
"of the Colorbox, or height of the Colorbox have been defined, ColorBox will "
"scale photos to fit within the those values"
msgstr ""
"Lorsque cette option est activée et si la largeur maximale des images, la "
"hauteur maximale des images, la largeur ou la hauteur de la Colorbox ont été "
"définies, alors la Colorbox redimensionnera les photos pour qu’elles "
"s’adaptent à ces valeurs"

#: ../templates/backend/settings-page.phtml:357
msgid "Close Colorbox on overlay click"
msgstr "Fermer la Colorbox en cliquant hors de l'image"

#: ../templates/backend/settings-page.phtml:361
msgid ""
"If checked, enables closing ColorBox by clicking on the background overlay"
msgstr ""
"Si elle est cochée, cette case active la fermeture de la ColorBox en "
"cliquant sur le recouvrement de l'arrière-plan"

#: ../templates/backend/settings-page.phtml:366
msgid "Preload images"
msgstr "Précharger les images"

#: ../templates/backend/settings-page.phtml:370
msgid ""
"Allows for preloading of \"next\" and \"previous\" content in a group, after "
"the current content has finished loading. Uncheck box to disable."
msgstr ""
"Permet de précharger les contenus \"suivant\" et \"précédent\" d'un groupe, "
"après que le contenu en cours a terminé son chargement. Décochez la case "
"pour désactiver la fonction."

#: ../templates/backend/settings-page.phtml:375
msgid "Transition type"
msgstr "Type de transition"

#: ../templates/backend/settings-page.phtml:387
msgid ""
"The transition type of the Colorbox. Can be set to \"elastic\", \"fade\", or "
"\"none\""
msgstr ""
"Le type de transition de la Colorbox. Il peut être fixé sur \"élasticité\", "
"\"fondu\" ou \"aucun\""

#: ../templates/backend/settings-page.phtml:392
msgid "Transition speed"
msgstr "Vitesse de transition"

#: ../templates/backend/settings-page.phtml:396
msgid ""
"Sets the speed of the \"fade\" and \"elastic\" transitions, in milliseconds"
msgstr ""
"Fixe la vitesse des transitions \"effacé\" et \"élastique\", en millisecondes"

#: ../templates/backend/settings-page.phtml:401
msgid "Opacity"
msgstr "Opacité"

#: ../templates/backend/settings-page.phtml:405
msgid "The overlay opacity level. Range: 0 to 1"
msgstr "Le niveau d'opacité du recouvrement. Plage : 0 à 1"

#: ../templates/backend/settings-page.phtml:422
#: ../templates/backend/settings-page.phtml:430
msgid "Delete Settings"
msgstr "Supprimer les paramètres"

#: ../templates/backend/settings-page.phtml:423
msgid "Check the box and click this button to delete settings of this plugin."
msgstr ""
"Cochez la case et cliquez sur ce bouton pour supprimer les paramètres de ce "
"plugin."

